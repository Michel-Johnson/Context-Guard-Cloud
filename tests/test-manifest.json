{
  "schemaVersion": 1,
  "automaticNodeTests": {
    "roots": [
      ".github/scripts",
      "tests"
    ],
    "suffix": ".test.mjs",
    "excluded": [
      ".github/scripts/security-checks.test.mjs"
    ]
  },
  "standaloneSuites": [
    {
      "path": "tests/coordinator-dialogue-live-browser.mjs",
      "command": "npm run test:dialogue:live",
      "purpose": "显式运行真实模型与浏览器的需求、归属确认、改绑和审批闭环；隔离项目数据。"
    },
    {
      "path": ".github/scripts/security-checks.test.mjs",
      "command": "npm run security:test",
      "purpose": "Fail-closed source, history and final artifact secret scanning."
    },
    {
      "path": "tests/browser-device-login-runner.mjs",
      "command": "npm run test:browser",
      "purpose": "Real Chromium acceptance with isolated synthetic project data."
    },
    {
      "path": "tests/cloud-workbench-browser.mjs",
      "command": "npm run test:browser",
      "purpose": "Real Chromium acceptance with isolated synthetic project data."
    },
    {
      "path": "tests/cloud-sync-browser.mjs",
      "command": "npm run test:browser",
      "purpose": "Real Chromium acceptance with isolated synthetic project data."
    }
  ],
  "helpers": [
    {
      "path": "tests/helpers/openclaw-map.mjs",
      "usedBy": "tests/map-relations-independent.test.mjs"
    },
    {
      "path": "tests/helpers/skill.mjs",
      "usedBy": "tests/interface-events.test.mjs"
    }
  ],
  "separatePackages": [
    {
      "root": "plugins/slack"
    }
  ],
